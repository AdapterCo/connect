PORT=3009
NODE_ENV=production

# JWT — use pelo menos 32 caracteres aleatorios (ex: openssl rand -base64 48)
JWT_SECRET=replace-with-at-least-32-random-characters

# Banco de dados
# Senha do Postgres usada pelo docker-compose/stack (obrigatoria). Em um volume ja
# existente, deve ser a senha com que o banco foi criado.
DB_PASSWORD=
DATABASE_URL=postgresql://appuser:STRONG_PASSWORD@db:5432/adapterconnect?schema=public

# Chave de criptografia simetrica para segredos no banco (32+ chars)
ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Superadmin da plataforma: criado na inicializacao se ainda nao existir (8+ chars).
# Apos o primeiro login, a variavel pode ser removida.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=

# Precos dos planos para self-service sem superadmin: com preco definido, o plano
# nasce ativo na primeira inicializacao e o cliente escolhe, paga e usa sozinho.
# So aplica a planos ainda nao configurados (nunca sobrescreve edicoes).
# Deixe vazio para definir preco/ativacao pelo painel do superadmin.
PLAN_ESSENCIAL_PRICE=
PLAN_PROFISSIONAL_PRICE=
PLAN_EMPRESARIAL_PRICE=

# Mercado Pago da PLATAFORMA (conta do dono do SaaS, nao do cliente)
# Obter em: https://www.mercadopago.com.br/developers/panel/credentials
PLATFORM_MP_ACCESS_TOKEN=APP_USR-seu-access-token-aqui
PLATFORM_MP_PUBLIC_KEY=APP_USR-sua-public-key-aqui

# Pagamentos sao confirmados por polling direto na API do Mercado Pago (sem webhook).

# SMTP para envio do link de recuperacao de senha (porta 465 = TLS direto; demais = STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Adapter Connect <no-reply@seudominio.com.br>"
# URL publica do painel usada nos links enviados por e-mail (padrao: https://DOMAIN)
APP_URL=

# Dominio publico da aplicacao (sem https://)
DOMAIN=connect.adapterco.com.br

# Politica de retencao de dados (LGPD)
RETENTION_ENABLED=false
AUDIT_LOG_RETENTION_DAYS=365
SYSTEM_LOG_RETENTION_DAYS=180
MESSAGE_RETENTION_DAYS=0

# Limite de midia por empresa, incluindo uploads e entrada WhatsApp (MB)
MEDIA_QUOTA_MB=1024
# Analise de imagens recebidas usando a chave Gemini configurada pela empresa
VISION_ENABLED=false
# Transcricao de audio recebido: so com a IA ativada pela empresa e usando a
# chave Gemini dela (nao ha chave da plataforma).

# Notificacoes push (opcional). Sem estas chaves, um par e gerado e guardado no
# banco; trocar de banco invalida as inscricoes ja feitas nos navegadores.
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do responsavel pelo envio (padrao: https://DOMAIN)
VAPID_SUBJECT=mailto:suporte@seudominio.com.br

# Pasta das midias (padrao: public/uploads)
UPLOAD_DIR=
# Nivel de log da conexao WhatsApp: silent (padrao), error, warn, info, debug
WHATSAPP_LOG_LEVEL=silent
