datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Plan {
  id            String    @id @default(uuid())
  name          String    @unique
  max_instances Int       @default(1)
  max_users     Int       @default(2)
  max_products  Int       @default(30)
  price         Decimal   @default(0) @db.Decimal(12, 2)
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  companies     Company[]
  subscriptions Subscription[]
  signupCheckouts SignupCheckout[]
}

model Company {
  sales_rotation_cursor String?
  id              String             @id @default(uuid())
  name            String
  slug            String             @unique
  logo_url        String?
  primary_color   String?
  plan            String             @default("free")
  plan_id         String?
  max_instances   Int                @default(1)
  max_users       Int                @default(2)
  max_products    Int                @default(30)
  is_active       Boolean            @default(true)
  expires_at      DateTime?
  mp_access_token String?
  mp_public_key   String?
  mp_enabled      Boolean            @default(false)
  mp_webhook_url  String?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt
  plan_relation   Plan?              @relation(fields: [plan_id], references: [id], onDelete: SetNull)
  users           User[]
  settings        Settings?
  instances       Instance[]
  chats           Chat[]
  scheduled       ScheduledMessage[]
  logs            Log[]
  metrics         Metric[]
  subscriptions   Subscription[]
  invoices        Invoice[]
  auditLogs       AuditLog[]
  categories      Category[]
  products        Product[]
  orders          Order[]
  printers        Printer[]
  flows           Flow[]
}

model User {
  kanban_columns KanbanColumn[]
  id              String               @id @default(uuid())
  name            String
  username        String               @unique
  email           String?              @unique
  phone           String?
  password        String
  role            String
  sector          String?
  status          String               @default("offline")
  session_version Int                  @default(0)
  company_id      String
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt
  company         Company              @relation(fields: [company_id], references: [id], onDelete: Cascade)
  resetTokens     PasswordResetToken[]
  soldProducts    Product[]
  instances       Instance[]

  @@unique([id, company_id])
}

model Settings {
  id            String   @id @default(uuid())
  company_id    String   @unique
  ai_enabled    Boolean  @default(false)
  ai_provider   String   @default("mock")
  gemini_key    String?
  openai_key    String?
  grok_key      String?
  gemini_model  String?
  openai_model  String?
  grok_model    String?
  system_prompt String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  company       Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
}

model Instance {
  id         String   @id
  name       String
  phone      String?
  status     String   @default("disconnected")
  company_id String
  user_id    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  company    Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  chats      Chat[]
}

model Chat {
  sales_reply_due_at DateTime?
  kanban_cards KanbanCard[]
  id            String    @id
  remote_jid    String?
  client_name   String
  client_phone  String
  status        String    @default("iniciada")
  assigned_to   String?
  ai_active     Boolean   @default(true)
  tags          String[]
  is_favorite   Boolean   @default(false)
  is_archived   Boolean   @default(false)
  is_blocked    Boolean   @default(false)
  sector        String?
  company_id    String
  instance_id   String
  waiting_since DateTime?
  claimed_at    DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  company       Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  instance      Instance  @relation(fields: [instance_id], references: [id], onDelete: Cascade)
  messages      Message[]
  orders        Order[]
  flow_session  FlowSession?

  @@index([company_id])
  @@index([company_id, status])
  @@index([instance_id])
  @@index([remote_jid])
  @@unique([company_id, instance_id, remote_jid])
  @@unique([id, company_id])
  @@index([status, sales_reply_due_at])
}

model KanbanColumn {
  id String @id @default(uuid())
  company_id String
  user_id String
  name String
  created_at DateTime @default(now())
  owner User @relation(fields: [user_id, company_id], references: [id, company_id], onDelete: Cascade)
  cards KanbanCard[]
  @@unique([id, user_id, company_id])
  @@unique([user_id, name])
}

model KanbanCard {
  id String @id @default(uuid())
  company_id String
  user_id String
  chat_id String
  column_id String
  column KanbanColumn @relation(fields: [column_id, user_id, company_id], references: [id, user_id, company_id], onDelete: Cascade)
  chat Chat @relation(fields: [chat_id, company_id], references: [id, company_id], onDelete: Cascade)
  @@unique([user_id, chat_id])
  @@index([column_id])
}

model Message {
  id             String   @id @default(uuid())
  chat_id        String
  sender         String
  sender_id      String?
  text           String
  timestamp      DateTime @default(now())
  is_ai          Boolean  @default(false)
  is_note        Boolean  @default(false)
  is_scheduled   Boolean  @default(false)
  media_url      String?
  media_type     String?
  file_name      String?
  payment_id     String?
  payment_url    String?
  payment_status String?
  chat           Chat     @relation(fields: [chat_id], references: [id], onDelete: Cascade)

  @@index([chat_id])
  @@index([payment_id])
  @@index([chat_id, timestamp])
}

model ScheduledMessage {
  status        String   @default("pending")
  attempts      Int      @default(0)
  next_attempt_at DateTime @default(now())
  locked_at     DateTime?
  last_error    String?
  sent_at       DateTime?
  id            String   @id @default(uuid())
  chat_id       String
  client_name   String
  text          String?
  scheduledTime DateTime
  media_url     String?
  media_type    String?
  file_name     String?
  created_by    String
  company_id    String
  created_at    DateTime @default(now())
  company       Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@index([status, next_attempt_at, scheduledTime])
}

model Log {
  id         String   @id @default(uuid())
  message    String
  company_id String
  timestamp  DateTime @default(now())
  company    Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@index([company_id, timestamp])
}

model Metric {
  id               String   @id @default(uuid())
  type             String
  chat_id          String
  attendant_id     String?
  is_ai            Boolean  @default(false)
  duration_seconds Int
  company_id       String
  timestamp        DateTime @default(now())
  company          Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@index([company_id, type])
}

model Subscription {
  id                    String    @id @default(uuid())
  company_id            String
  plan_id               String
  status                String    @default("active")
  current_period_start  DateTime
  current_period_end    DateTime
  mp_subscription_id    String?
  mp_payer_id           String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  company               Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  plan                  Plan      @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  invoices              Invoice[]

  @@index([company_id])
  @@index([company_id, status])
}

model Invoice {
  id              String        @id @default(uuid())
  company_id      String
  subscription_id String?
  amount          Decimal @db.Decimal(12, 2)
  status          String        @default("pending")
  mp_payment_id   String?
  mp_payment_url  String?
  due_date        DateTime
  paid_at         DateTime?
  created_at      DateTime      @default(now())
  company         Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  subscription    Subscription? @relation(fields: [subscription_id], references: [id], onDelete: SetNull)

  @@index([company_id])
  @@index([mp_payment_id])
}

model SignupCheckout {
  id                 String   @id @default(uuid())
  company_name       String
  company_slug       String
  admin_name         String
  admin_username     String
  admin_password     String
  payer_email        String
  plan_id            String
  amount             Decimal @db.Decimal(12, 2)
  status             String   @default("pending")
  mp_payment_id      String?
  mp_payment_url     String?
  due_date           DateTime
  paid_at            DateTime?
  company_id         String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  plan               Plan     @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@index([mp_payment_id])
  @@index([status])
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  company_id String
  user_id    String?
  user_name  String?
  action     String
  entity     String
  entity_id  String?
  details    String?
  ip         String?
  user_agent String?
  timestamp  DateTime @default(now())
  company    Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@index([company_id, timestamp(sort: Desc)])
}

model Category {
  id         String    @id @default(uuid())
  name       String
  slug       String
  is_active  Boolean   @default(true)
  sort_order Int       @default(0)
  company_id String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  company    Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  products   Product[]
  
  printer_id String?
  printer    Printer?  @relation(fields: [printer_id], references: [id], onDelete: SetNull)

  @@unique([company_id, slug])
}

model Product {
  seller_id    String?
  seller       User? @relation(fields: [seller_id, company_id], references: [id, company_id], onDelete: Restrict)
  down_payment Decimal @default(0) @db.Decimal(12, 2)
  payment_method String?
  serial       String?
  color        String?
  memory       String?
  condition    String?
  status       String @default("stock")
  sold_at      DateTime?

  @@unique([company_id, serial])
  @@index([company_id, seller_id, status, sold_at])
  id           String            @id @default(uuid())
  name         String
  slug         String
  description  String?
  price        Float
  image_url    String?
  is_active    Boolean           @default(true)
  sort_order   Int               @default(0)
  category_id  String
  company_id   String
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt
  category     Category          @relation(fields: [category_id], references: [id], onDelete: Cascade)
  company      Company           @relation(fields: [company_id], references: [id], onDelete: Cascade)
  variants     ProductVariant[]
  addons       ProductAddon[]
  orderItems   OrderItem[]

  @@unique([company_id, slug])
}

model ProductVariant {
  id         String   @id @default(uuid())
  name       String
  price_diff Float    @default(0)
  product_id String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
}

model ProductAddon {
  id         String   @id @default(uuid())
  name       String
  price      Float
  product_id String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  orderItems OrderItemAddon[]
}

model Order {
  id              String      @id @default(uuid())
  chat_id         String
  status          String      @default("pending")
  subtotal        Float
  discount        Float       @default(0)
  total           Float
  payment_method  String?
  payment_status  String      @default("pending")
  notes           String?
  printed         Boolean     @default(false)
  printed_at      DateTime?
  company_id      String
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  chat            Chat        @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  company         Company     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  items           OrderItem[]

  @@index([company_id])
  @@index([chat_id])
  @@index([company_id, status])
}

model OrderItem {
  id         String           @id @default(uuid())
  product_id String
  variant_id String?
  quantity   Int              @default(1)
  unit_price Float
  total      Float
  notes      String?
  order_id   String
  created_at DateTime         @default(now())
  product    Product          @relation(fields: [product_id], references: [id], onDelete: Cascade)
  order      Order            @relation(fields: [order_id], references: [id], onDelete: Cascade)
  addons     OrderItemAddon[]
}

model OrderItemAddon {
  id            String       @id @default(uuid())
  addon_id      String
  quantity      Int          @default(1)
  order_item_id String
  created_at    DateTime     @default(now())
  addon         ProductAddon @relation(fields: [addon_id], references: [id], onDelete: Cascade)
  orderItem     OrderItem    @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
}

model Printer {
  id         String     @id @default(uuid())
  name       String
  ip_address String
  port       Int        @default(9100)
  is_active  Boolean    @default(true)
  company_id String
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  company    Company    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  categories Category[]
}

// Fluxo de atendimento montado no editor visual. graph = { nodes, edges }.
// Apenas um fluxo ativo por empresa: ele atende toda conversa nova.
model Flow {
  id         String        @id @default(uuid())
  company_id String
  name       String
  is_active  Boolean       @default(false)
  graph      Json
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt
  company    Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  sessions   FlowSession[]

  @@index([company_id, is_active])
}

// Execucao do fluxo em uma conversa: no atual e respostas captadas (variables).
model FlowSession {
  graph_snapshot  Json?
  id              String    @id @default(uuid())
  chat_id         String    @unique
  company_id      String
  flow_id         String?
  flow_name       String
  current_node_id String?
  status          String    @default("active")
  variables       Json      @default("{}")
  retries         Int       @default(0)
  started_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  finished_at     DateTime?
  chat            Chat      @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  flow            Flow?     @relation(fields: [flow_id], references: [id], onDelete: SetNull)

  @@index([company_id, status])
}

// Uma tentativa permanece vinculada a cobranca, mesmo apos novas tentativas.
model PaymentAttempt {
  id String @id @default(uuid())
  charge_id String
  charge_type String
  idempotency_key String @unique
  mp_payment_id String? @unique
  status String @default("creating")
  created_at DateTime @default(now())
  checked_at DateTime?
  @@index([status, checked_at])
  @@index([charge_id])
}
model MediaDeletion {
  url String @id
  created_at DateTime @default(now())
  attempts Int @default(0)
  @@index([created_at])
}
